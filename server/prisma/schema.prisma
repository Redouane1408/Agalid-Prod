generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  Particulier
  Entreprise
  Industrie
  Administration
}

model ClientRequest {
  id                 Int         @id @default(autoincrement())
  createdAt          DateTime    @default(now())
  name               String
  email              String
  phone              String
  address            String
  clientType         ClientType
  monthlyConsumption Int
  householdSize      Int
  energyUsagePattern String
  appliances         String[]
  roofArea           Int
  roofType           String
  location           String
  peakSunHours       Float
  hasShading         Boolean
  budget             Int
  notes              String?
  quotes             Quote[]
}

model Quote {
  id                   Int       @id @default(autoincrement())
  createdAt            DateTime  @default(now())
  requestId            Int
  request              ClientRequest @relation(fields: [requestId], references: [id])
  totalDa              Int
  hardwareSubtotalDa   Int       @default(0)
  installationSubtotalDa Int     @default(0)
  marginSubtotalDa     Int       @default(0)
  taxSubtotalDa        Int       @default(0)
  panelCount           Int
  systemKw             Float
  status               String
  sentAt               DateTime?
  calculationSnapshot  Json?
  items                QuoteItem[]
}

model QuoteItem {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  quote     Quote   @relation(fields: [quoteId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model OwnerSettings {
  id                       Int      @id @default(autoincrement())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  services                 String[]
  displayQuoteOnSite       Boolean   @default(true)
  sendEmailQuote           Boolean   @default(true)
  sendWhatsappQuote        Boolean   @default(true)
  requiredFields           String[]
  defaultSystemEfficiency  Float     @default(0.85)
  defaultPanelAreaM2       Float     @default(2.2)
  defaultPanelPowerKw      Float     @default(0.55)
  minimumPanelCount        Int       @default(1)
  inverterSizingSafetyFactor Float   @default(1.1)
  quoteValidityDays        Int       @default(30)
  installationBaseCostDa   Int       @default(0)
  installationCostPerPanelDa Int     @default(0)
  structureCostPerPanelDa  Int       @default(0)
  cablingCostPerKwDa       Int       @default(0)
  protectionCostDa         Int       @default(0)
  transportCostDa          Int       @default(0)
  maintenanceCostDa        Int       @default(0)
  shadingCostPercent       Float     @default(0)
  marginPercent            Float     @default(0)
  taxPercent               Float     @default(0)
  roofTypeMultipliers      Json?
  clientTypeMultipliers    Json?
  businessRules            Json?
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER") // ADMIN, USER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  integrations UserIntegration[]
}

model UserIntegration {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  provider    String   // e.g., "linky", "enphase", "tesla"
  apiKey      String?  // Legacy or simple API Key
  accessToken String?  // OAuth Access Token
  refreshToken String? // OAuth Refresh Token
  expiresAt   DateTime? // Token expiration
  isConnected Boolean  @default(false)
  lastSync    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String?
  images      String[]
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  stock       Int      @default(0)
  specs       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quoteItems  QuoteItem[]
}

